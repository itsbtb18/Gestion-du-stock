<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns:fx="http://javafx.com/fxml" 
      fx:controller="org.example.controller.StockController"
      styleClass="content-container" 
      stylesheets="@../css/styles.css"
      spacing="20">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>
    
    <!-- Header Card -->
    <VBox spacing="18" styleClass="content-card">
        <padding>
            <Insets top="24" right="28" bottom="24" left="28"/>
        </padding>
        <HBox alignment="CENTER_LEFT" spacing="20">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Gestion du Stock" styleClass="page-title">
                    <font>
                        <Font name="Segoe UI Bold" size="24"/>
                    </font>
                </Label>
                <Label text="Gérer les mouvements et alertes de stock" styleClass="page-subtitle">
                    <font>
                        <Font name="Segoe UI" size="14"/>
                    </font>
                </Label>
            </VBox>
            <HBox spacing="12" alignment="CENTER_RIGHT">
                <VBox spacing="4" alignment="CENTER">
                    <Label fx:id="lblNombreAlertes" text="Alertes: 0" 
                          styleClass="kpi-value" style="-fx-text-fill: #16A34A; -fx-font-size: 16px;">
                        <font>
                            <Font name="Segoe UI Bold" size="16"/>
                        </font>
                    </Label>
                </VBox>
                <Button text="🔔 Voir Alertes" styleClass="btn-primary" 
                       prefHeight="42" prefWidth="150" onAction="#handleVoirAlertes">
                    <font>
                        <Font name="Segoe UI Semibold" size="14"/>
                    </font>
                </Button>
            </HBox>
        </HBox>
    </VBox>
    
    <!-- Main Content: Two Columns -->
    <HBox spacing="24" VBox.vgrow="ALWAYS">
        
        <!-- Left: Movements History (65%) -->
        <VBox spacing="20" styleClass="content-card" HBox.hgrow="ALWAYS" prefWidth="780">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>
            
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="📋 Historique des Mouvements" styleClass="section-title">
                    <font>
                        <Font name="Segoe UI Bold" size="18"/>
                    </font>
                </Label>
                
                <Region HBox.hgrow="ALWAYS"/>
                
                <Button text="↻ Actualiser" styleClass="btn-secondary" 
                       prefHeight="40" prefWidth="130" onAction="#handleActualiser">
                    <font>
                        <Font name="Segoe UI Semibold" size="13"/>
                    </font>
                </Button>
            </HBox>
            
            <Separator styleClass="glass-separator"/>
            
            <!-- Movements Table -->
            <TableView fx:id="tableMouvements" styleClass="modern-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colProduit" text="Produit" prefWidth="200"/>
                    <TableColumn fx:id="colType" text="Type" prefWidth="120"/>
                    <TableColumn fx:id="colQuantite" text="Quantité" prefWidth="90"/>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="150"/>
                    <TableColumn fx:id="colMotif" text="Motif" prefWidth="220"/>
                </columns>
            </TableView>
            
            <!-- Info Footer -->
            <HBox spacing="16" alignment="CENTER_LEFT" styleClass="glass-info-box">
                <padding>
                    <Insets top="12" right="12" bottom="12" left="12"/>
                </padding>
                <Label text="💡" style="-fx-font-size: 18px;"/>
                <VBox spacing="4">
                    <Label text="Types de mouvements:" style="-fx-text-fill: #667085; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                    <Label text="ENTREE: Réception | SORTIE: Vente | AJUSTEMENT: Correction | RETOUR: Retour client" 
                          style="-fx-text-fill: #7B8394; -fx-font-size: 11px;" wrapText="true"/>
                </VBox>
            </HBox>
        </VBox>
        
        <!-- Right: New Movement Form (35%) -->
        <VBox spacing="20" styleClass="content-card" prefWidth="420">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>
            
            <Label text="➕ Nouveau Mouvement" styleClass="section-title">
                <font>
                    <Font name="Segoe UI Bold" size="18"/>
                </font>
            </Label>
            
            <Separator styleClass="glass-separator"/>
            
            <VBox spacing="8">
                <Label text="Produit *" styleClass="filter-label">
                    <font>
                        <Font name="Segoe UI Semibold" size="13"/>
                    </font>
                </Label>
                <ComboBox fx:id="cmbProduit" styleClass="modern-combo" 
                         prefHeight="44" maxWidth="Infinity"/>
            </VBox>
            
            <VBox spacing="8">
                <Label text="Type de Mouvement *" styleClass="filter-label">
                    <font>
                        <Font name="Segoe UI Semibold" size="13"/>
                    </font>
                </Label>
                <ComboBox fx:id="cmbTypeMouvement" styleClass="modern-combo" 
                         prefHeight="44" maxWidth="Infinity"/>
            </VBox>
            
            <VBox spacing="8">
                <Label text="Quantité *" styleClass="filter-label">
                    <font>
                        <Font name="Segoe UI Semibold" size="13"/>
                    </font>
                </Label>
                <TextField fx:id="txtQuantite" styleClass="modern-input" 
                          promptText="Ex: 50" prefHeight="44"/>
            </VBox>
            
            <!-- Stock Display -->
            <HBox styleClass="glass-info-box" spacing="12" alignment="CENTER_LEFT">
                <padding>
                    <Insets top="16" right="16" bottom="16" left="16"/>
                </padding>
                <Label text="📊" style="-fx-font-size: 24px;"/>
                <Label fx:id="lblStockActuel" text="Stock actuel: -" 
                      styleClass="kpi-value" style="-fx-text-fill: #667085; -fx-font-size: 16px;">
                    <font>
                        <Font name="Segoe UI Bold" size="16"/>
                    </font>
                </Label>
            </HBox>
            
            <VBox spacing="8" VBox.vgrow="ALWAYS">
                <Label text="Motif / Notes" styleClass="filter-label">
                    <font>
                        <Font name="Segoe UI Semibold" size="13"/>
                    </font>
                </Label>
                <TextArea fx:id="txtMotif" styleClass="glass-textarea" 
                         promptText="Raison du mouvement..." 
                         prefRowCount="4" wrapText="true"/>
            </VBox>
            
            <Separator styleClass="glass-separator"/>
            
            <!-- Action Buttons -->
            <HBox spacing="12" alignment="CENTER">
                <Button text="💾 Enregistrer" styleClass="btn-primary" 
                       prefHeight="48" prefWidth="170" onAction="#handleEnregistrerMouvement">
                    <font>
                        <Font name="Segoe UI Semibold" size="14"/>
                    </font>
                </Button>
                
                <Button text="🔄 Réinitialiser" styleClass="btn-secondary" 
                       prefHeight="48" prefWidth="160" onAction="#handleReinitialiser">
                    <font>
                        <Font name="Segoe UI Semibold" size="14"/>
                    </font>
                </Button>
            </HBox>
        </VBox>
    </HBox>
</VBox>