<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controller.BonCommandeController"
      stylesheets="@../css/styles.css"
      styleClass="content-container"
      spacing="24"
      prefHeight="900">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Gestion des Bons de Commande" styleClass="page-title"/>
            <Label text="Gérer les commandes fournisseurs" styleClass="page-subtitle"/>
        </VBox>
        <Button fx:id="newButton" 
                text="+ Nouveau" 
                styleClass="btn-primary" 
                onAction="#handleNew"
                prefHeight="40"/>
    </HBox>

    <!-- Main Content: Two Column Layout -->
    <HBox spacing="24" prefHeight="350" minHeight="350">
        
        <!-- Left Column: Orders List -->
        <VBox spacing="16" styleClass="content-card" HBox.hgrow="ALWAYS">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            
            <Label text="Liste des Commandes" styleClass="section-title"/>
            
            <TableView fx:id="commandeTable" 
                       styleClass="modern-table"
                       VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="numeroColumn" text="Numéro" prefWidth="100"/>
                    <TableColumn fx:id="fournisseurColumn" text="Fournisseur" prefWidth="150"/>
                    <TableColumn fx:id="dateColumn" text="Date" prefWidth="100"/>
                    <TableColumn fx:id="statutColumn" text="Statut" prefWidth="100"/>
                    <TableColumn fx:id="totalColumn" text="Total (DH)" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>

        <!-- Right Column: Order Details Form (Scrollable) -->
        <ScrollPane styleClass="form-scroll" fitToWidth="true" 
                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    prefWidth="420" minWidth="420" maxWidth="420">
            <VBox spacing="12" styleClass="content-card">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                
                <Label text="Détails de la Commande" styleClass="section-title"/>
                
                <VBox spacing="6">
                    <Label text="Numéro" styleClass="form-label"/>
                    <Label fx:id="numeroLabel" 
                           text="Nouveau" 
                           style="-fx-text-fill: #667085; -fx-font-size: 14px;"/>
                </VBox>
                
                <VBox spacing="6">
                    <Label text="Fournisseur *" styleClass="form-label"/>
                    <ComboBox fx:id="fournisseurCombo" 
                              styleClass="modern-combo"
                              prefHeight="38"
                              prefWidth="360"/>
                </VBox>
                
                <VBox spacing="6">
                    <Label text="Statut" styleClass="form-label"/>
                    <ComboBox fx:id="statutCombo" 
                              styleClass="modern-combo"
                              prefHeight="38"
                              prefWidth="360"/>
                </VBox>
                
                <VBox spacing="6">
                    <Label text="Date Commande" styleClass="form-label"/>
                    <DatePicker fx:id="dateCommandePicker" 
                                styleClass="modern-date-picker"
                                prefHeight="38"
                                prefWidth="360"/>
                </VBox>
                
                <VBox spacing="6">
                    <Label text="Date Livraison" styleClass="form-label"/>
                    <DatePicker fx:id="dateLivraisonPicker" 
                                styleClass="modern-date-picker"
                                prefHeight="38"
                                prefWidth="360"/>
                </VBox>
                
                <VBox spacing="6">
                    <Label text="Notes" styleClass="form-label"/>
                    <TextArea fx:id="notesArea" 
                              styleClass="modern-textarea"
                              promptText="Instructions de livraison..."
                              prefRowCount="3"
                              wrapText="true"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </HBox>
    <!-- ^^^ THIS WAS MISSING! -->

    <!-- Line Items Section -->
    <VBox spacing="16" styleClass="content-card" prefHeight="400">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>
        
        <Label text="Articles Commandés" styleClass="section-title"/>
        
        <!-- Add Line Form -->
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="filter-bar">
            <padding>
                <Insets top="8" right="12" bottom="8" left="12"/>
            </padding>
            
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Produit" style="-fx-font-size: 11px; -fx-text-fill: #667085;"/>
                <ComboBox fx:id="produitCombo" 
                          styleClass="modern-combo"
                          prefHeight="36"/>
            </VBox>
            
            <VBox spacing="2" prefWidth="100">
                <Label text="Quantité" style="-fx-font-size: 11px; -fx-text-fill: #667085;"/>
                <TextField fx:id="quantiteField" 
                           styleClass="modern-input"
                           promptText="Qté"
                           prefHeight="36"/>
            </VBox>
            
            <VBox spacing="2" prefWidth="100">
                <Label text="Prix Unit." style="-fx-font-size: 11px; -fx-text-fill: #667085;"/>
                <TextField fx:id="prixUnitaireField" 
                           styleClass="modern-input"
                           promptText="Prix"
                           prefHeight="36"/>
            </VBox>
            
            <VBox spacing="2" alignment="BOTTOM_LEFT">
                <Label text=" " style="-fx-font-size: 11px;"/>
                <HBox spacing="6">
                    <Button fx:id="addLineButton" 
                            text="➕ Ajouter" 
                            styleClass="btn-primary"
                            onAction="#handleAddLine"
                            prefHeight="36"
                            prefWidth="130"/>
                    <Button fx:id="removeLineButton" 
                            text="➖ Retirer" 
                            styleClass="btn-danger"
                            onAction="#handleRemoveLine"
                            prefHeight="36"
                            prefWidth="130"/>
                </HBox>
            </VBox>
        </HBox>

        <!-- Lines Table -->
        <TableView fx:id="lignesTable" 
                   styleClass="modern-table"
                   VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="produitColumn" text="Produit" prefWidth="300"/>
                <TableColumn fx:id="quantiteColumn" text="Quantité" prefWidth="100"/>
                <TableColumn fx:id="prixColumn" text="Prix Unit." prefWidth="120"/>
                <TableColumn fx:id="totalLigneColumn" text="Total" prefWidth="120"/>
            </columns>
        </TableView>
        
        <!-- Totals -->
        <HBox spacing="40" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="12" right="20" bottom="0" left="0"/>
            </padding>
            
            <HBox spacing="12">
                <Label text="Total HT:" styleClass="form-label"/>
                <Label fx:id="totalHTLabel" text="0.00 DH" style="-fx-font-weight: bold;"/>
            </HBox>
            
            <HBox spacing="12">
                <Label text="TVA (20%):" styleClass="form-label"/>
                <Label fx:id="taxeLabel" text="0.00 DH" style="-fx-font-weight: bold;"/>
            </HBox>
            
            <HBox spacing="12">
                <Label text="Total TTC:" styleClass="form-label" style="-fx-font-size: 14px;"/>
                <Label fx:id="totalTTCLabel" text="0.00 DH" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
            </HBox>
        </HBox>
    </VBox>

    <!-- Action Buttons -->
    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button fx:id="saveButton" 
                text="💾 Enregistrer" 
                styleClass="btn-primary"
                onAction="#handleSave"
                prefHeight="38"/>
        
        <Button fx:id="updateButton" 
                text="✏️ Modifier" 
                styleClass="btn-primary"
                prefHeight="38"/>
        
        <Button fx:id="approveButton" 
                text="✅ Valider" 
                styleClass="btn-success"
                onAction="#handleApprove"
                prefHeight="38"/>
        
        <Button fx:id="receiveButton" 
                text="📦 Réceptionner" 
                styleClass="btn-primary"
                onAction="#handleReceive"
                prefHeight="38"/>
        
        <Region HBox.hgrow="ALWAYS"/>
        
        <Button fx:id="clearButton" 
                text="🔄 Vider" 
                styleClass="btn-secondary"
                onAction="#handleClear"
                prefHeight="38"/>
        
        <Button fx:id="deleteButton" 
                text="🗑️ Supprimer" 
                styleClass="btn-danger"
                prefHeight="38"/>
    </HBox>
</VBox>
