<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.chart.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controller.StatistiquesController"
      styleClass="content-container" stylesheets="@../css/styles.css" spacing="20">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    
    <!-- Header Card -->
    <VBox spacing="18" styleClass="content-card">
        <padding>
            <Insets top="24" right="28" bottom="24" left="28"/>
        </padding>
        <HBox alignment="CENTER_LEFT" spacing="20">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Statistiques" styleClass="page-title">
                    <font>
                        <Font name="Segoe UI Bold" size="24"/>
                    </font>
                </Label>
                <Label text="Vue d'ensemble des performances" styleClass="page-subtitle">
                    <font>
                        <Font name="Segoe UI" size="14"/>
                    </font>
                </Label>
            </VBox>
            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Label text="Période:" styleClass="filter-label">
                    <font>
                        <Font name="Segoe UI Semibold" size="13"/>
                    </font>
                </Label>
                <ComboBox fx:id="comboPeriode" styleClass="modern-combo" prefHeight="42" prefWidth="180"/>
                <Button fx:id="btnRefresh" text="↻ Actualiser" styleClass="btn-primary" 
                       prefHeight="42" prefWidth="150">
                    <font>
                        <Font name="Segoe UI Semibold" size="14"/>
                    </font>
                </Button>
            </HBox>
        </HBox>
    </VBox>
    
    <!-- KPI Cards Grid -->
    <GridPane hgap="20" vgap="20">
        <columnConstraints>
            <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
            <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
            <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
        </columnConstraints>
        
        <!-- Row 1 -->
        <VBox styleClass="glass-stat-card success" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <HBox alignment="CENTER" spacing="15">
                <Label text="💰" styleClass="stat-icon">
                    <font>
                        <Font size="36"/>
                    </font>
                </Label>
                <VBox>
                    <Label text="Chiffre d'Affaires" styleClass="kpi-label">
                        <font>
                            <Font name="Segoe UI Semibold" size="12"/>
                        </font>
                    </Label>
                    <Label fx:id="lblChiffreAffaires" text="0.00 DZD" styleClass="kpi-value" 
                          textFill="#4caf50">
                        <font>
                            <Font name="Segoe UI Bold" size="24"/>
                        </font>
                    </Label>
                </VBox>
            </HBox>
        </VBox>
        
        <VBox styleClass="glass-stat-card info" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <HBox alignment="CENTER" spacing="15">
                <Label text="🛒" styleClass="stat-icon">
                    <font>
                        <Font size="36"/>
                    </font>
                </Label>
                <VBox>
                    <Label text="Nombre de Ventes" styleClass="kpi-label">
                        <font>
                            <Font name="Segoe UI Semibold" size="12"/>
                        </font>
                    </Label>
                    <Label fx:id="lblNombreVentes" text="0" styleClass="kpi-value" 
                          textFill="#2196f3">
                        <font>
                            <Font name="Segoe UI Bold" size="24"/>
                        </font>
                    </Label>
                </VBox>
            </HBox>
        </VBox>
        
        <VBox styleClass="glass-stat-card warning" GridPane.columnIndex="2" GridPane.rowIndex="0">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <HBox alignment="CENTER" spacing="15">
                <Label text="📊" styleClass="stat-icon">
                    <font>
                        <Font size="36"/>
                    </font>
                </Label>
                <VBox>
                    <Label text="Panier Moyen" styleClass="kpi-label">
                        <font>
                            <Font name="Segoe UI Semibold" size="12"/>
                        </font>
                    </Label>
                    <Label fx:id="lblPanierMoyen" text="0.00 DZD" styleClass="kpi-value" 
                          textFill="#ff9800">
                        <font>
                            <Font name="Segoe UI Bold" size="24"/>
                        </font>
                    </Label>
                </VBox>
            </HBox>
        </VBox>
        
        <!-- Row 2 -->
        <VBox styleClass="glass-stat-card" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <HBox alignment="CENTER" spacing="15">
                <Label text="👥" styleClass="stat-icon">
                    <font>
                        <Font size="36"/>
                    </font>
                </Label>
                <VBox>
                    <Label text="Clients" styleClass="kpi-label">
                        <font>
                            <Font name="Segoe UI Semibold" size="12"/>
                        </font>
                    </Label>
                    <Label fx:id="lblNombreClients" text="0" styleClass="kpi-value">
                        <font>
                            <Font name="Segoe UI Bold" size="24"/>
                        </font>
                    </Label>
                </VBox>
            </HBox>
        </VBox>
        
        <VBox styleClass="glass-stat-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <HBox alignment="CENTER" spacing="15">
                <Label text="📦" styleClass="stat-icon">
                    <font>
                        <Font size="36"/>
                    </font>
                </Label>
                <VBox>
                    <Label text="Produits en Stock" styleClass="kpi-label">
                        <font>
                            <Font name="Segoe UI Semibold" size="12"/>
                        </font>
                    </Label>
                    <Label fx:id="lblProduitsEnStock" text="0" styleClass="kpi-value">
                        <font>
                            <Font name="Segoe UI Bold" size="24"/>
                        </font>
                    </Label>
                </VBox>
            </HBox>
        </VBox>
        
        <VBox styleClass="glass-stat-card danger" GridPane.columnIndex="2" GridPane.rowIndex="1">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <HBox alignment="CENTER" spacing="15">
                <Label text="⚠️" styleClass="stat-icon">
                    <font>
                        <Font size="36"/>
                    </font>
                </Label>
                <VBox>
                    <Label text="Alertes Stock" styleClass="kpi-label">
                        <font>
                            <Font name="Segoe UI Semibold" size="12"/>
                        </font>
                    </Label>
                    <Label fx:id="lblAlertes" text="0" styleClass="kpi-value" textFill="#f44336">
                        <font>
                            <Font name="Segoe UI Bold" size="24"/>
                        </font>
                    </Label>
                </VBox>
            </HBox>
        </VBox>
    </GridPane>
    
    <!-- Charts Row -->
    <HBox spacing="20" VBox.vgrow="ALWAYS">
        
        <!-- Sales Trend Chart -->
        <VBox styleClass="content-card" HBox.hgrow="ALWAYS" spacing="16">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>
            
            <Label text="📈 Évolution des Ventes" styleClass="card-title">
                <font>
                    <Font name="Segoe UI Bold" size="18"/>
                </font>
            </Label>
            
            <LineChart fx:id="chartVentes" legendVisible="false" prefHeight="280">
                <xAxis>
                    <CategoryAxis side="BOTTOM"/>
                </xAxis>
                <yAxis>
                    <NumberAxis side="LEFT"/>
                </yAxis>
            </LineChart>
        </VBox>
        
        <!-- Top Products Chart -->
        <VBox styleClass="content-card" HBox.hgrow="ALWAYS" spacing="16">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>
            
            <Label text="🏆 Top Produits" styleClass="card-title">
                <font>
                    <Font name="Segoe UI Bold" size="18"/>
                </font>
            </Label>
            
            <BarChart fx:id="chartTopProduits" legendVisible="false" prefHeight="280">
                <xAxis>
                    <CategoryAxis side="BOTTOM"/>
                </xAxis>
                <yAxis>
                    <NumberAxis side="LEFT"/>
                </yAxis>
            </BarChart>
        </VBox>
        
        <!-- Categories Pie Chart -->
        <VBox styleClass="content-card" HBox.hgrow="ALWAYS" spacing="16">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>
            
            <Label text="🥧 Répartition Catégories" styleClass="card-title">
                <font>
                    <Font name="Segoe UI Bold" size="18"/>
                </font>
            </Label>
            
            <PieChart fx:id="chartCategories" legendVisible="true" prefHeight="280"/>
        </VBox>
    </HBox>
    
    <!-- Recent Sales Table -->
    <VBox styleClass="content-card" spacing="16">
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>
        
        <HBox alignment="CENTER_LEFT">
            <Label text="🕒 Ventes Récentes" styleClass="card-title">
                <font>
                    <Font name="Segoe UI Bold" size="18"/>
                </font>
            </Label>
        </HBox>
        
        <TableView fx:id="tableRecentVentes" styleClass="modern-table" prefHeight="200">
            <columns>
                <TableColumn fx:id="colNumero" text="N° Vente" prefWidth="150"/>
                <TableColumn fx:id="colDate" text="Date" prefWidth="180"/>
                <TableColumn fx:id="colMontant" text="Montant (DZD)" prefWidth="150"/>
            </columns>
            <placeholder>
                <VBox alignment="CENTER" spacing="10">
                    <Label text="🛒" style="-fx-font-size: 36px; -fx-opacity: 0.3;"/>
                    <Label text="Aucune vente récente" styleClass="placeholder-label">
                        <font>
                            <Font name="Segoe UI" size="14"/>
                        </font>
                    </Label>
                </VBox>
            </placeholder>
        </TableView>
    </VBox>
</VBox>
