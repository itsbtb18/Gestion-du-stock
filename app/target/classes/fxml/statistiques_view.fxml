<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.chart.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controller.StatistiquesController"
            styleClass="content-area" stylesheets="@../css/styles.css">
    
    <!-- Top: Header & Period Selector -->
    <top>
        <VBox spacing="15">
            <VBox styleClass="card">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <VBox>
                        <Label text="📈 Tableau de Bord" styleClass="section-title">
                            <font>
                                <Font name="System Bold" size="24"/>
                            </font>
                        </Label>
                        <Label text="Vue d'ensemble des performances et statistiques" 
                              styleClass="section-subtitle">
                            <font>
                                <Font size="14"/>
                            </font>
                        </Label>
                    </VBox>
                    
                    <Region HBox.hgrow="ALWAYS"/>
                    
                    <HBox spacing="10" alignment="CENTER">
                        <Label text="Période:" styleClass="form-label">
                            <font>
                                <Font name="System Bold" size="13"/>
                            </font>
                        </Label>
                        <ComboBox fx:id="comboPeriode" styleClass="modern-combo-box" prefWidth="150"/>
                        <Button fx:id="btnRefresh" text="↻ Actualiser" styleClass="btn-primary" 
                               onAction="#handleRefresh">
                            <font>
                                <Font name="System Bold" size="13"/>
                            </font>
                        </Button>
                    </HBox>
                </HBox>
            </VBox>
            
            <!-- KPI Cards Grid -->
            <GridPane hgap="15" vgap="15">
                <!-- Row 1 -->
                <VBox styleClass="stat-card success" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>
                    <HBox alignment="CENTER" spacing="15">
                        <Label text="💰" styleClass="stat-icon">
                            <font>
                                <Font size="36"/>
                            </font>
                        </Label>
                        <VBox>
                            <Label text="Chiffre d'Affaires" styleClass="stat-label"/>
                            <Label fx:id="lblChiffreAffaires" text="0.00 DH" styleClass="stat-value" 
                                  textFill="#4caf50">
                                <font>
                                    <Font name="System Bold" size="24"/>
                                </font>
                            </Label>
                        </VBox>
                    </HBox>
                </VBox>
                
                <VBox styleClass="stat-card info" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>
                    <HBox alignment="CENTER" spacing="15">
                        <Label text="🛒" styleClass="stat-icon">
                            <font>
                                <Font size="36"/>
                            </font>
                        </Label>
                        <VBox>
                            <Label text="Nombre de Ventes" styleClass="stat-label"/>
                            <Label fx:id="lblNombreVentes" text="0" styleClass="stat-value" 
                                  textFill="#2196f3">
                                <font>
                                    <Font name="System Bold" size="24"/>
                                </font>
                            </Label>
                        </VBox>
                    </HBox>
                </VBox>
                
                <VBox styleClass="stat-card warning" GridPane.columnIndex="2" GridPane.rowIndex="0">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>
                    <HBox alignment="CENTER" spacing="15">
                        <Label text="📊" styleClass="stat-icon">
                            <font>
                                <Font size="36"/>
                            </font>
                        </Label>
                        <VBox>
                            <Label text="Panier Moyen" styleClass="stat-label"/>
                            <Label fx:id="lblPanierMoyen" text="0.00 DH" styleClass="stat-value" 
                                  textFill="#ff9800">
                                <font>
                                    <Font name="System Bold" size="24"/>
                                </font>
                            </Label>
                        </VBox>
                    </HBox>
                </VBox>
                
                <!-- Row 2 -->
                <VBox styleClass="stat-card" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>
                    <HBox alignment="CENTER" spacing="15">
                        <Label text="👥" styleClass="stat-icon">
                            <font>
                                <Font size="36"/>
                            </font>
                        </Label>
                        <VBox>
                            <Label text="Clients" styleClass="stat-label"/>
                            <Label fx:id="lblNombreClients" text="0" styleClass="stat-value">
                                <font>
                                    <Font name="System Bold" size="24"/>
                                </font>
                            </Label>
                        </VBox>
                    </HBox>
                </VBox>
                
                <VBox styleClass="stat-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>
                    <HBox alignment="CENTER" spacing="15">
                        <Label text="📦" styleClass="stat-icon">
                            <font>
                                <Font size="36"/>
                            </font>
                        </Label>
                        <VBox>
                            <Label text="Produits en Stock" styleClass="stat-label"/>
                            <Label fx:id="lblProduitsEnStock" text="0" styleClass="stat-value">
                                <font>
                                    <Font name="System Bold" size="24"/>
                                </font>
                            </Label>
                        </VBox>
                    </HBox>
                </VBox>
                
                <VBox styleClass="stat-card danger" GridPane.columnIndex="2" GridPane.rowIndex="1">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>
                    <HBox alignment="CENTER" spacing="15">
                        <Label text="⚠️" styleClass="stat-icon">
                            <font>
                                <Font size="36"/>
                            </font>
                        </Label>
                        <VBox>
                            <Label text="Alertes Stock" styleClass="stat-label"/>
                            <Label fx:id="lblAlertes" text="0" styleClass="stat-value" textFill="#f44336">
                                <font>
                                    <Font name="System Bold" size="24"/>
                                </font>
                            </Label>
                        </VBox>
                    </HBox>
                </VBox>
            </GridPane>
        </VBox>
    </top>
    
    <!-- Center: Charts & Recent Sales -->
    <center>
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
            <VBox spacing="20">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                
                <!-- Charts Row -->
                <HBox spacing="20" HBox.hgrow="ALWAYS">
                    
                    <!-- Sales Trend Chart -->
                    <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="10">
                        <padding>
                            <Insets top="20" right="20" bottom="20" left="20"/>
                        </padding>
                        
                        <Label text="📈 Évolution des Ventes" styleClass="section-title">
                            <font>
                                <Font name="System Bold" size="16"/>
                            </font>
                        </Label>
                        
                        <LineChart fx:id="chartVentes" styleClass="modern-chart" 
                                  legendVisible="false" prefHeight="300">
                            <xAxis>
                                <CategoryAxis side="BOTTOM"/>
                            </xAxis>
                            <yAxis>
                                <NumberAxis side="LEFT"/>
                            </yAxis>
                        </LineChart>
                    </VBox>
                    
                    <!-- Categories Pie Chart -->
                    <VBox styleClass="card" prefWidth="350" spacing="10">
                        <padding>
                            <Insets top="20" right="20" bottom="20" left="20"/>
                        </padding>
                        
                        <Label text="🥧 Répartition par Catégorie" styleClass="section-title">
                            <font>
                                <Font name="System Bold" size="16"/>
                            </font>
                        </Label>
                        
                        <PieChart fx:id="chartCategories" styleClass="modern-chart" 
                                 legendVisible="true" prefHeight="300"/>
                    </VBox>
                </HBox>
                
                <!-- Top Products Chart -->
                <VBox styleClass="card" spacing="10">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>
                    
                    <Label text="🏆 Top 5 Produits" styleClass="section-title">
                        <font>
                            <Font name="System Bold" size="16"/>
                        </font>
                    </Label>
                    
                    <BarChart fx:id="chartTopProduits" styleClass="modern-chart" 
                             legendVisible="false" prefHeight="280">
                        <xAxis>
                            <CategoryAxis side="BOTTOM"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis side="LEFT"/>
                        </yAxis>
                    </BarChart>
                </VBox>
                
                <!-- Recent Sales Table -->
                <VBox styleClass="card" spacing="10">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>
                    
                    <HBox alignment="CENTER_LEFT">
                        <Label text="🕒 Ventes Récentes" styleClass="section-title">
                            <font>
                                <Font name="System Bold" size="16"/>
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Voir tout" styleClass="btn-secondary"/>
                    </HBox>
                    
                    <TableView fx:id="tableRecentVentes" styleClass="modern-table" prefHeight="250">
                        <columns>
                            <TableColumn fx:id="colNumero" text="N° Vente" prefWidth="120"/>
                            <TableColumn fx:id="colDate" text="Date" prefWidth="150"/>
                            <TableColumn fx:id="colMontant" text="Montant (DH)" prefWidth="120"/>
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" spacing="10">
                                <Label text="🛒" style="-fx-font-size: 36px; -fx-opacity: 0.3;"/>
                                <Label text="Aucune vente récente" styleClass="text-muted">
                                    <font>
                                        <Font size="13"/>
                                    </font>
                                </Label>
                            </VBox>
                        </placeholder>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
