<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controller.RapportController"
      styleClass="content-container" stylesheets="@../css/styles.css" spacing="20">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    
    <!-- Header -->
    <VBox spacing="18" styleClass="content-card">
        <padding>
            <Insets top="24" right="28" bottom="24" left="28"/>
        </padding>
        <HBox alignment="CENTER_LEFT" spacing="20">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Rapports" styleClass="page-title">
                    <font>
                        <Font name="Segoe UI Bold" size="24"/>
                    </font>
                </Label>
                <Label text="Générez des rapports détaillés" styleClass="page-subtitle">
                    <font>
                        <Font name="Segoe UI" size="14"/>
                    </font>
                </Label>
            </VBox>
            <HBox spacing="12" alignment="CENTER_RIGHT">
                <DatePicker fx:id="dateDebut" promptText="Date début" 
                           styleClass="glass-date-picker" prefHeight="42" prefWidth="140"/>
                <DatePicker fx:id="dateFin" promptText="Date fin" 
                           styleClass="glass-date-picker" prefHeight="42" prefWidth="140"/>
                <ComboBox fx:id="comboTypeRapport" promptText="Type" 
                         styleClass="modern-combo" prefHeight="42" prefWidth="150"/>
                <Button fx:id="btnGenerer" text="🔍 Générer" styleClass="btn-primary"
                       prefHeight="42" prefWidth="130">
                    <font>
                        <Font name="Segoe UI Semibold" size="14"/>
                    </font>
                </Button>
                <Button fx:id="btnExporterCSV" text="📥 Exporter" styleClass="btn-primary"
                       prefHeight="42" prefWidth="140">
                    <font>
                        <Font name="Segoe UI Semibold" size="14"/>
                    </font>
                </Button>
            </HBox>
        </HBox>
    </VBox>
    
    <!-- KPI Cards -->
    <HBox spacing="20">
        <VBox styleClass="glass-stat-card success" HBox.hgrow="ALWAYS">
            <padding>
                <Insets top="18" right="18" bottom="18" left="18"/>
            </padding>
            <Label text="💰 Total Ventes" styleClass="kpi-label">
                <font>
                    <Font name="Segoe UI Semibold" size="12"/>
                </font>
            </Label>
            <Label fx:id="lblTotalVentes" text="0.00 DZD" textFill="#4caf50" 
                   style="-fx-font-weight: bold; -fx-font-size: 24px;">
                <font>
                    <Font name="Segoe UI Bold" size="24"/>
                </font>
            </Label>
        </VBox>
        
        <VBox styleClass="glass-stat-card info" HBox.hgrow="ALWAYS">
            <padding>
                <Insets top="18" right="18" bottom="18" left="18"/>
            </padding>
            <Label text="🛒 Nombre de Ventes" styleClass="kpi-label">
                <font>
                    <Font name="Segoe UI Semibold" size="12"/>
                </font>
            </Label>
            <Label fx:id="lblNombreVentes" text="0" textFill="#2196f3" 
                   style="-fx-font-weight: bold; -fx-font-size: 24px;">
                <font>
                    <Font name="Segoe UI Bold" size="24"/>
                </font>
            </Label>
        </VBox>
        
        <VBox styleClass="glass-stat-card warning" HBox.hgrow="ALWAYS">
            <padding>
                <Insets top="18" right="18" bottom="18" left="18"/>
            </padding>
            <Label text="📊 Panier Moyen" styleClass="kpi-label">
                <font>
                    <Font name="Segoe UI Semibold" size="12"/>
                </font>
            </Label>
            <Label fx:id="lblMoyenneVente" text="0.00 DZD" textFill="#ff9800" 
                   style="-fx-font-weight: bold; -fx-font-size: 24px;">
                <font>
                    <Font name="Segoe UI Bold" size="24"/>
                </font>
            </Label>
        </VBox>
    </HBox>
    
    <!-- Tables -->
    <VBox styleClass="content-card" VBox.vgrow="ALWAYS" spacing="20">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>
        
        <!-- Sales Table -->
        <VBox spacing="12" VBox.vgrow="ALWAYS">
            <Label text="💳 Rapport des Ventes" styleClass="card-title">
                <font>
                    <Font name="Segoe UI Bold" size="16"/>
                </font>
            </Label>
            
            <TableView fx:id="tableVentes" styleClass="modern-table" prefHeight="250">
                <columns>
                    <TableColumn fx:id="colNumero" text="N° Vente" prefWidth="110"/>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="140"/>
                    <TableColumn fx:id="colClient" text="Client" prefWidth="220"/>
                    <TableColumn fx:id="colMontant" text="Montant (DZD)" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>
        
        <Separator styleClass="glass-separator"/>
        
        <!-- Stock Movements Table -->
        <VBox spacing="12" VBox.vgrow="ALWAYS">
            <Label text="📦 Rapport des Mouvements de Stock" styleClass="card-title">
                <font>
                    <Font name="Segoe UI Bold" size="16"/>
                </font>
            </Label>
            
            <TableView fx:id="tableMouvements" styleClass="modern-table" prefHeight="250">
                <columns>
                    <TableColumn fx:id="colProduit" text="Produit" prefWidth="240"/>
                    <TableColumn fx:id="colType" text="Type" prefWidth="120"/>
                    <TableColumn fx:id="colQuantite" text="Quantité" prefWidth="90"/>
                    <TableColumn fx:id="colDateMouvement" text="Date" prefWidth="140"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</VBox>

