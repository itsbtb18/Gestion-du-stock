org.h2.jdbc.JdbcSQLSyntaxErrorException: View "V_STOCK_ACTUEL" already exists; SQL statement:
CREATE VIEW v_stock_actuel AS
SELECT 
    p.id,
    p.code,
    p.nom,
    c.nom AS categorie,
    p.quantite_stock,
    p.seuil_alerte,
    CASE 
        WHEN p.quantite_stock <= p.seuil_alerte THEN 'BAS'
        WHEN p.quantite_stock = 0 THEN 'RUPTURE'
        ELSE 'NORMAL'
    END AS statut_stock,
    p.prix,
    (p.quantite_stock * p.prix) AS valeur_stock
FROM produits p
LEFT JOIN categories c ON p.categorie_id = c.id
WHERE p.actif = TRUE [90038-224]
