<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controller.StoreSettingsController"
      stylesheets="@../css/styles.css"
      styleClass="content-container"
      spacing="24">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
    
    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Parametres du Magasin" styleClass="page-title"/>
            <Label text="Configuration complete de votre magasin" styleClass="page-subtitle"/>
        </VBox>
        <Button fx:id="saveButton" 
                text="Enregistrer" 
                onAction="#handleSave"
                styleClass="btn-primary" 
                prefHeight="40"
                prefWidth="150"/>
    </HBox>
    
    <TabPane fx:id="settingsTabPane" VBox.vgrow="ALWAYS">
        
        <!-- Store Info Tab -->
        <Tab text="Informations" closable="false">
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                <VBox spacing="20" style="-fx-padding: 20;">
                    
                    <!-- Basic Info Card -->
                    <VBox spacing="16" styleClass="content-card">
                        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                        
                        <Label text="Informations de Base" styleClass="section-title"/>
                        
                        <HBox spacing="16">
                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <Label text="Code Magasin" styleClass="form-label"/>
                                <TextField fx:id="storeCodeField" 
                                           styleClass="modern-input"
                                           promptText="Ex: MAG001"
                                           prefHeight="40"/>
                            </VBox>
                            
                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <Label text="Nom du Magasin" styleClass="form-label"/>
                                <TextField fx:id="storeNameField" 
                                           styleClass="modern-input"
                                           promptText="Ex: REB7A Store"
                                           prefHeight="40"/>
                            </VBox>
                        </HBox>
                        
                        <VBox spacing="8">
                            <Label text="Adresse" styleClass="form-label"/>
                            <TextArea fx:id="storeAddressField" 
                                      styleClass="modern-textarea"
                                      promptText="Adresse complete du magasin"
                                      prefRowCount="3"
                                      wrapText="true"/>
                        </VBox>
                        
                        <HBox spacing="16">
                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <Label text="Telephone" styleClass="form-label"/>
                                <TextField fx:id="storePhoneField" 
                                           styleClass="modern-input"
                                           promptText="+212 XXX-XXXXXX"
                                           prefHeight="40"/>
                            </VBox>
                            
                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <Label text="Email" styleClass="form-label"/>
                                <TextField fx:id="storeEmailField" 
                                           styleClass="modern-input"
                                           promptText="contact@magasin.com"
                                           prefHeight="40"/>
                            </VBox>
                        </HBox>
                        
                        <VBox spacing="8">
                            <Label text="Logo du Magasin" styleClass="form-label"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <TextField fx:id="storeLogoField" 
                                           styleClass="modern-input"
                                           promptText="Chemin du logo"
                                           prefHeight="40"
                                           HBox.hgrow="ALWAYS"/>
                                <Button text="Parcourir" 
                                        onAction="#handleBrowseLogo"
                                        styleClass="btn-secondary"
                                        prefHeight="40"
                                        prefWidth="130"/>
                            </HBox>
                        </VBox>
                        
                        <HBox spacing="16">
                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <Label text="Devise" styleClass="form-label"/>
                                <ComboBox fx:id="currencyCombo" 
                                          styleClass="modern-combo"
                                          prefHeight="40"
                                          prefWidth="250"/>
                            </VBox>
                            
                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <Label text="Langue" styleClass="form-label"/>
                                <ComboBox fx:id="languageCombo" 
                                          styleClass="modern-combo"
                                          prefHeight="40"
                                          prefWidth="250"/>
                            </VBox>
                        </HBox>
                        
                        <CheckBox fx:id="storeActiveCheck" 
                                  text="Magasin actif et operationnel"
                                  style="-fx-font-size: 14px; -fx-font-weight: 600;"/>
                    </VBox>
                    
                </VBox>
            </ScrollPane>
        </Tab>
        
        <!-- Promotions Tab -->
        <Tab text="Promotions" closable="false">
            <VBox spacing="16" styleClass="content-card">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Gestion des Promotions" styleClass="section-title" HBox.hgrow="ALWAYS"/>
                    <Button text="Ajouter" 
                            onAction="#handleAddPromotion"
                            styleClass="btn-primary"
                            prefHeight="38"/>
                    <Button text="Modifier" 
                            onAction="#handleEditPromotion"
                            styleClass="btn-secondary"
                            prefHeight="38"/>
                    <Button text="Supprimer" 
                            onAction="#handleDeletePromotion"
                            styleClass="btn-danger"
                            prefHeight="38"/>
                    <Button text="Actualiser" 
                            onAction="#handleRefreshPromotions"
                            styleClass="btn-secondary"
                            prefHeight="38"/>
                </HBox>
                
                <TableView fx:id="promotionsTable" 
                           styleClass="modern-table"
                           VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="promoNameColumn" text="Nom" prefWidth="180"/>
                        <TableColumn fx:id="promoTypeColumn" text="Type" prefWidth="120"/>
                        <TableColumn fx:id="promoValueColumn" text="Valeur" prefWidth="100"/>
                        <TableColumn fx:id="promoScopeColumn" text="Portee" prefWidth="120"/>
                        <TableColumn fx:id="promoStartColumn" text="Debut" prefWidth="110"/>
                        <TableColumn fx:id="promoEndColumn" text="Fin" prefWidth="110"/>
                        <TableColumn fx:id="promoActiveColumn" text="Actif" prefWidth="80"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>
        
        <!-- Loyalty Tab -->
        <Tab text="Fidelite" closable="false">
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                <VBox spacing="20" style="-fx-padding: 20;">
                    
                    <VBox spacing="16" styleClass="content-card">
                        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                        
                        <CheckBox fx:id="loyaltyEnabledCheck" 
                                  text="Activer le Programme de Fidelite"
                                  style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    </VBox>
                    
                    <VBox spacing="16" styleClass="content-card">
                        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                        
                        <Label text="Configuration des Points" styleClass="section-title"/>
                        
                        <HBox spacing="16">
                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <Label text="Points par Unite Monetaire" styleClass="form-label"/>
                                <Spinner fx:id="pointsPerCurrencySpinner" 
                                         prefWidth="150"
                                         prefHeight="40"/>
                            </VBox>
                            
                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <Label text="Achat Minimum (DZD)" styleClass="form-label"/>
                                <TextField fx:id="minPurchaseField" 
                                           styleClass="modern-input"
                                           prefHeight="40"/>
                            </VBox>
                        </HBox>
                        
                        <HBox spacing="16">
                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <Label text="Seuil de Recompense (Points)" styleClass="form-label"/>
                                <Spinner fx:id="rewardThresholdSpinner" 
                                         prefWidth="150"
                                         prefHeight="40"/>
                            </VBox>
                            
                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <Label text="Type de Recompense" styleClass="form-label"/>
                                <ComboBox fx:id="rewardTypeCombo" 
                                          styleClass="modern-combo"
                                          prefHeight="40"
                                          prefWidth="250"/>
                            </VBox>
                            
                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <Label text="Valeur Recompense" styleClass="form-label"/>
                                <TextField fx:id="rewardValueField" 
                                           styleClass="modern-input"
                                           prefHeight="40"/>
                            </VBox>
                        </HBox>
                    </VBox>
                    
                    <VBox spacing="16" styleClass="content-card">
                        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                        
                        <Label text="Parametres d Echange" styleClass="section-title"/>
                        
                        <CheckBox fx:id="allowPartialRedemptionCheck" 
                                  text="Autoriser l echange partiel des points"
                                  style="-fx-font-size: 14px;"/>
                        
                        <HBox spacing="16">
                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <Label text="Points Minimum pour Echange" styleClass="form-label"/>
                                <Spinner fx:id="minRedemptionPointsSpinner" 
                                         prefWidth="150"
                                         prefHeight="40"/>
                            </VBox>
                            
                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <Label text="Pourcentage Maximum d Echange" styleClass="form-label"/>
                                <Spinner fx:id="maxRedemptionPercentSpinner" 
                                         prefWidth="150"
                                         prefHeight="40"/>
                            </VBox>
                            
                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <Label text="Expiration Points (Jours)" styleClass="form-label"/>
                                <Spinner fx:id="pointsExpirationSpinner" 
                                         prefWidth="150"
                                         prefHeight="40"/>
                            </VBox>
                        </HBox>
                    </VBox>
                    
                </VBox>
            </ScrollPane>
        </Tab>
        
        <!-- Advanced Tab -->
        <Tab text="Avance" closable="false">
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                <VBox spacing="20" style="-fx-padding: 20;">
                    
                    <VBox spacing="16" styleClass="content-card">
                        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                        
                        <Label text="Gestion du Stock" styleClass="section-title"/>
                        
                        <CheckBox fx:id="allowNegativeStockCheck" 
                                  text="Autoriser le stock negatif"
                                  style="-fx-font-size: 14px;"/>
                        <CheckBox fx:id="lowStockNotificationsCheck" 
                                  text="Activer les notifications de stock bas"
                                  style="-fx-font-size: 14px;"/>
                        <CheckBox fx:id="expirationAlertsCheck" 
                                  text="Activer les alertes d expiration"
                                  style="-fx-font-size: 14px;"/>
                        
                        <VBox spacing="8" style="-fx-padding-top: 10;">
                            <Label text="Jours avant Alerte d Expiration" styleClass="form-label"/>
                            <Spinner fx:id="expirationAlertDaysSpinner" 
                                     prefWidth="150"
                                     prefHeight="40"/>
                        </VBox>
                    </VBox>
                    
                    <VBox spacing="16" styleClass="content-card">
                        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                        
                        <Label text="Regles Commerciales" styleClass="section-title"/>
                        
                        <CheckBox fx:id="requireManagerApprovalCheck" 
                                  text="Approbation du manager requise pour les remises"
                                  style="-fx-font-size: 14px;"/>
                        
                        <HBox spacing="16">
                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <Label text="Remise Maximum (pourcent)" styleClass="form-label"/>
                                <TextField fx:id="maxDiscountField" 
                                           styleClass="modern-input"
                                           prefHeight="40"/>
                            </VBox>
                            
                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <Label text="TVA par Defaut (pourcent)" styleClass="form-label"/>
                                <TextField fx:id="defaultVatRateField" 
                                           styleClass="modern-input"
                                           prefHeight="40"/>
                            </VBox>
                        </HBox>
                    </VBox>
                    
                    <VBox spacing="16" styleClass="content-card">
                        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                        
                        <Label text="Configuration des Factures" styleClass="section-title"/>
                        
                        <VBox spacing="8">
                            <Label text="En-tete de Facture" styleClass="form-label"/>
                            <TextField fx:id="invoiceHeaderField" 
                                       styleClass="modern-input"
                                       promptText="Texte d en-tete"
                                       prefHeight="40"/>
                        </VBox>
                        
                        <VBox spacing="8">
                            <Label text="Pied de Page de Facture" styleClass="form-label"/>
                            <TextArea fx:id="invoiceFooterField" 
                                      styleClass="modern-textarea"
                                      promptText="Texte de pied de page"
                                      prefRowCount="3"
                                      wrapText="true"/>
                        </VBox>
                    </VBox>
                    
                </VBox>
            </ScrollPane>
        </Tab>
        
    </TabPane>
    
    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button fx:id="cancelButton" 
                text="Annuler" 
                onAction="#handleCancel"
                styleClass="btn-secondary" 
                prefHeight="42"
                prefWidth="130"/>
    </HBox>
    
</VBox>
