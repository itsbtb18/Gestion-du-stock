<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.shape.Circle?>


<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controller.MainController"
            styleClass="app-root" stylesheets="@../css/styles.css">
    
    <!-- Left: Main Navigation Sidebar -->
    <left>
        <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    styleClass="sidebar-scroll" prefWidth="200" minWidth="200" maxWidth="200">
            <content>
                <VBox styleClass="sidebar" prefWidth="200" minWidth="200" spacing="0">
                    <padding>
                        <Insets top="20" right="0" bottom="16" left="0"/>
                    </padding>
            
            <!-- Logo + Brand at Top -->
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="sidebar-logo-container">
                <padding>
                    <Insets top="16" right="20" bottom="16" left="20"/>
                </padding>
               <ImageView fitWidth="70" fitHeight="70" preserveRatio="true"
                       style="-fx-effect: dropshadow(gaussian, rgba(255, 255, 255, 0.15), 8, 0, 0, 2);">
                   <image>
                            <Image url="@../images/reb7a_logo2.png"/>
                   </image>
                   <clip>
                         <Circle radius="30" centerX="33" centerY="33"/>
                    </clip>
               </ImageView>


                <Label text="REB7A" styleClass="sidebar-brand-text">
                    <font>
                        <Font name="Segoe UI Black" size="18"/>
                    </font>
                </Label>
            </HBox>
            
            <!-- Spacing -->
            <Region minHeight="20"/>
            
            <!-- Navigation Buttons -->
            <VBox spacing="4">
                <padding>
                    <Insets top="0" right="16" bottom="0" left="16"/>
                </padding>
                
                <Button fx:id="btnDashboard" text="  🏠  Tableau de Bord" onAction="#handleDashboardView" 
                       styleClass="sidebar-nav-button, " 
                       maxWidth="Infinity" prefHeight="44" alignment="CENTER_LEFT">
                    <padding>
                        <Insets left="16"/>
                    </padding>
                    <font>
                        <Font name="Segoe UI Semibold" size="14"/>
                    </font>
                </Button>
                
                <Button fx:id="btnCaisse" text="  🛒  Caisse" onAction="#handleCaisseView" 
                       styleClass="sidebar-nav-button" maxWidth="Infinity" prefHeight="44" alignment="CENTER_LEFT">
                    <padding>
                        <Insets left="16"/>
                    </padding>
                    <font>
                        <Font name="Segoe UI Semibold" size="14"/>
                    </font>
                </Button>
                
                <Button fx:id="btnClients" text="  👥  Clients" onAction="#handleClientsView" 
                       styleClass="sidebar-nav-button" maxWidth="Infinity" prefHeight="44" alignment="CENTER_LEFT">
                    <padding>
                        <Insets left="16"/>
                    </padding>
                    <font>
                        <Font name="Segoe UI Semibold" size="14"/>
                    </font>
                </Button>
                
                <Button fx:id="btnProduits" text="  📦  Produits" onAction="#handleProduitsView" 
                       styleClass="sidebar-nav-button" maxWidth="Infinity" prefHeight="44" alignment="CENTER_LEFT">
                    <padding>
                        <Insets left="16"/>
                    </padding>
                    <font>
                        <Font name="Segoe UI Semibold" size="14"/>
                    </font>
                </Button>
                
                <Button fx:id="btnStock" text="  📊  Stock" onAction="#handleStockView" 
                       styleClass="sidebar-nav-button" maxWidth="Infinity" prefHeight="44" alignment="CENTER_LEFT">
                    <padding>
                        <Insets left="16"/>
                    </padding>
                    <font>
                        <Font name="Segoe UI Semibold" size="14"/>
                    </font>
                </Button>
                
                <Button fx:id="btnFournisseurs" text="  🏭  Fournisseurs" onAction="#handleFournisseursView" 
                       styleClass="sidebar-nav-button" maxWidth="Infinity" prefHeight="44" alignment="CENTER_LEFT">
                    <padding>
                        <Insets left="16"/>
                    </padding>
                    <font>
                        <Font name="Segoe UI Semibold" size="14"/>
                    </font>
                </Button>
                
                <Button fx:id="btnCommandes" text="  📋  Commandes" onAction="#handleCommandesView" 
                       styleClass="sidebar-nav-button" maxWidth="Infinity" prefHeight="44" alignment="CENTER_LEFT">
                    <padding>
                        <Insets left="16"/>
                    </padding>
                    <font>
                        <Font name="Segoe UI Semibold" size="14"/>
                    </font>
                </Button>
                
                <Button fx:id="btnRetours" text="  ↩️  Retours" onAction="#handleRetoursView" 
                       styleClass="sidebar-nav-button" maxWidth="Infinity" prefHeight="44" alignment="CENTER_LEFT">
                    <padding>
                        <Insets left="16"/>
                    </padding>
                    <font>
                        <Font name="Segoe UI Semibold" size="14"/>
                    </font>
                </Button>
                
                <Button fx:id="btnTransferts" text="  🔄  Transferts" onAction="#handleTransfertsView" 
                       styleClass="sidebar-nav-button" maxWidth="Infinity" prefHeight="44" alignment="CENTER_LEFT">
                    <padding>
                        <Insets left="16"/>
                    </padding>
                    <font>
                        <Font name="Segoe UI Semibold" size="14"/>
                    </font>
                </Button>
            </VBox>
            
            <!-- Separator -->
            <Region VBox.vgrow="SOMETIMES" minHeight="24"/>
            
            <!-- Secondary Navigation -->
            <VBox spacing="4">
                <padding>
                    <Insets top="0" right="16" bottom="0" left="16"/>
                </padding>
                
                <Button fx:id="btnDepenses" text="  💸  Dépenses" onAction="#handleDepensesView" 
                       styleClass="sidebar-nav-button" maxWidth="Infinity" prefHeight="44" alignment="CENTER_LEFT">
                    <padding>
                        <Insets left="16"/>
                    </padding>
                    <font>
                        <Font name="Segoe UI Semibold" size="14"/>
                    </font>
                </Button>
                
                <Button fx:id="btnRapports" text="  📄  Rapports" onAction="#handleRapportsView" 
                       styleClass="sidebar-nav-button" maxWidth="Infinity" prefHeight="44" alignment="CENTER_LEFT">
                    <padding>
                        <Insets left="16"/>
                    </padding>
                    <font>
                        <Font name="Segoe UI Semibold" size="14"/>
                    </font>
                </Button>
                
                <Button fx:id="btnStatistiques" text="  📈  Statistiques" onAction="#handleStatistiquesView" 
                       styleClass="sidebar-nav-button" maxWidth="Infinity" prefHeight="44" alignment="CENTER_LEFT">
                    <padding>
                        <Insets left="16"/>
                    </padding>
                    <font>
                        <Font name="Segoe UI Semibold" size="14"/>
                    </font>
                </Button>
            </VBox>
            
            <!-- Bottom Spacer -->
            <Region VBox.vgrow="ALWAYS" minHeight="12"/>
            
            <!-- Settings at Bottom -->
            <VBox spacing="4">
                <padding>
                    <Insets top="0" right="16" bottom="0" left="16"/>
                </padding>
                
                <Button fx:id="btnSettings" text="  ⚙️  Paramètres" onAction="#handleSettingsView" 
                       styleClass="sidebar-nav-button" maxWidth="Infinity" prefHeight="44" alignment="CENTER_LEFT">
                    <padding>
                        <Insets left="16"/>
                    </padding>
                    <font>
                        <Font name="Segoe UI Semibold" size="14"/>
                    </font>
                </Button>
            </VBox>

           
            
            
            <!-- Logout Button (moved from header) -->
            <VBox spacing="4">
                <padding>
                    <Insets top="0" right="16" bottom="8" left="16"/>
                </padding>
                <Button fx:id="btnLogout" text="  🚪  Déconnexion" onAction="#handleLogout"
                       styleClass="sidebar-nav-button, sidebar-logout-button" 
                       maxWidth="Infinity" prefHeight="44" alignment="CENTER_LEFT">
                    <padding>
                        <Insets left="16"/>
                    </padding>
                    <font>
                        <Font name="Segoe UI Semibold" size="14"/>
                    </font>
                </Button>
            </VBox>
            
            <!-- Footer Info -->
            <VBox spacing="4" styleClass="sidebar-footer" alignment="CENTER">
                <padding>
                    <Insets top="12" right="16" bottom="16" left="16"/>
                </padding>
                <HBox spacing="8" alignment="CENTER">
                    <Label fx:id="lblDate" text="10/12/2025" styleClass="sidebar-footer-text">
                        <font>
                            <Font name="Segoe UI" size="11"/>
                        </font>
                    </Label>
                    <Label text="•" styleClass="sidebar-footer-text">
                        <font>
                            <Font size="8"/>
                        </font>
                    </Label>
                    <Label fx:id="lblRevenue" text="0 DH" styleClass="sidebar-footer-text">
                        <font>
                            <Font name="Segoe UI Semibold" size="11"/>
                        </font>
                    </Label>
                </HBox>
            </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </left>
    
    <!-- Hidden: Header Bar elements (preserved for controller compatibility) -->
    <top>
        <HBox visible="false" managed="false" prefHeight="0" maxHeight="0">
            <TextField fx:id="searchField" promptText="Rechercher..." visible="false" managed="false"/>
            <Button fx:id="btnSearch" text="🔍 Rechercher" visible="false" managed="false"/>
        </HBox>
    </top>
    
    <!-- Center: Content Area (controller wraps loaded views in ScrollPane) -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area" alignment="TOP_LEFT"
                   BorderPane.alignment="TOP_LEFT">
            <!-- Hidden labels for MainController compatibility -->
            <VBox fx:id="welcomeScreen" visible="false" managed="false">
                <Label fx:id="lblTodaySales"/>
                <Label fx:id="lblTodayRevenue"/>
                <Label fx:id="lblTotalProducts"/>
                <Label fx:id="lblStatus" visible="false" managed="false"/>
                <Label fx:id="lblTime" visible="false" managed="false"/>
            </VBox>
        </StackPane>
    </center>
    
</BorderPane>
