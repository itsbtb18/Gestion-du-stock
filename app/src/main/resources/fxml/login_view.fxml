<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.effect.DropShadow?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controller.LoginController"
           stylesheets="@../css/styles.css"
           prefWidth="1280" prefHeight="720">
    
    <ImageView fx:id="backgroundImage" preserveRatio="false" StackPane.alignment="CENTER">
        <image><Image url="@../images/background_image.jpg"/></image>
    </ImageView>
    
    <Region style="-fx-background-color: linear-gradient(to bottom right, rgba(0,0,0,0.5), rgba(0,0,0,0.7));" />
    
    <HBox alignment="CENTER" spacing="0">
        
        <VBox alignment="CENTER" spacing="0" HBox.hgrow="ALWAYS">
            <VBox alignment="CENTER_LEFT" spacing="10" maxWidth="550">
                <padding><Insets left="100"/></padding>
                
                <ImageView fitWidth="90" fitHeight="90" preserveRatio="true">
                    <image><Image url="@../images/reb7a_logo.png"/></image>
                    <effect><DropShadow color="rgba(0,0,0,0.6)" radius="25"/></effect>
                </ImageView>
                
                <Label text="Systeme de Gestion" style="-fx-text-fill: rgba(255,255,255,0.75); -fx-font-size: 18px; -fx-font-weight: 500;">
                    <VBox.margin><Insets top="25"/></VBox.margin>
                </Label>
                
                <Label text="Point de Vente" style="-fx-text-fill: white; -fx-font-size: 52px; -fx-font-weight: 800;">
                    <effect><DropShadow color="rgba(0,0,0,0.4)" radius="12"/></effect>
                </Label>
                
                <Label text="REB7A" style="-fx-text-fill: #60A5FA; -fx-font-size: 72px; -fx-font-weight: 900;">
                    <effect><DropShadow color="rgba(96,165,250,0.6)" radius="20"/></effect>
                </Label>
                
                <Label text="Gerez votre commerce avec efficacite,&#10;rapidite et simplicite." 
                       style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 20px; -fx-font-weight: 400; -fx-line-spacing: 4;" 
                       wrapText="true" maxWidth="450">
                    <VBox.margin><Insets top="25"/></VBox.margin>
                </Label>
                
                <HBox spacing="30" alignment="CENTER_LEFT">
                    <VBox.margin><Insets top="35"/></VBox.margin>
                    <VBox spacing="4" alignment="CENTER">
                        <Label text="500+" style="-fx-text-fill: #60A5FA; -fx-font-size: 28px; -fx-font-weight: 800;"/>
                        <Label text="Produits" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13px;"/>
                    </VBox>
                    <Region style="-fx-background-color: rgba(255,255,255,0.3); -fx-pref-width: 1; -fx-pref-height: 50;"/>
                    <VBox spacing="4" alignment="CENTER">
                        <Label text="24/7" style="-fx-text-fill: #60A5FA; -fx-font-size: 28px; -fx-font-weight: 800;"/>
                        <Label text="Disponible" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13px;"/>
                    </VBox>
                    <Region style="-fx-background-color: rgba(255,255,255,0.3); -fx-pref-width: 1; -fx-pref-height: 50;"/>
                    <VBox spacing="4" alignment="CENTER">
                        <Label text="100%" style="-fx-text-fill: #60A5FA; -fx-font-size: 28px; -fx-font-weight: 800;"/>
                        <Label text="Securise" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 13px;"/>
                    </VBox>
                </HBox>
            </VBox>
        </VBox>
        
        <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
            <VBox alignment="CENTER" spacing="0" maxWidth="420" minWidth="400"
                  style="-fx-background-color: rgba(15,23,42,0.85); -fx-background-radius: 28; -fx-border-color: rgba(255,255,255,0.15); -fx-border-radius: 28; -fx-border-width: 1;">
                <effect><DropShadow color="rgba(0,0,0,0.5)" radius="50" spread="0.02"/></effect>
                <padding><Insets top="45" right="45" bottom="45" left="45"/></padding>
                
                <Label text="Connexion" style="-fx-text-fill: white; -fx-font-size: 36px; -fx-font-weight: 800;"/>
                
                <Label text="Bienvenue ! Entrez vos identifiants" 
                       style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 15px;">
                    <VBox.margin><Insets top="8"/></VBox.margin>
                </Label>
                
                <VBox spacing="22" maxWidth="330">
                    <VBox.margin><Insets top="35"/></VBox.margin>
                    
                    <VBox spacing="10">
                        <Label text="NOM D'UTILISATEUR" style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 12px; -fx-font-weight: 700;"/>
                        <TextField fx:id="txtUsername" promptText="Entrez votre identifiant" 
                                  prefHeight="55"
                                  style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 14; -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 14; -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.4); -fx-font-size: 16px; -fx-padding: 14 18;">
                        </TextField>
                    </VBox>
                    
                    <VBox spacing="10">
                        <Label text="MOT DE PASSE" style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 12px; -fx-font-weight: 700;"/>
                        <PasswordField fx:id="txtPassword" promptText="Entrez votre mot de passe" 
                                      prefHeight="55"
                                      style="-fx-background-color: rgba(255,255,255,0.08); -fx-background-radius: 14; -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 14; -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.4); -fx-font-size: 16px; -fx-padding: 14 18;">
                        </PasswordField>
                    </VBox>
                    
                    <HBox alignment="CENTER_LEFT">
                        <CheckBox fx:id="chkRememberMe" text="Se souvenir de moi" 
                                  style="-fx-text-fill: rgba(255,255,255,0.75); -fx-font-size: 14px;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Hyperlink text="Mot de passe oublie?" 
                                   style="-fx-text-fill: #60A5FA; -fx-font-size: 14px; -fx-font-weight: 600; -fx-underline: false;"/>
                    </HBox>
                    
                    <Label fx:id="lblError" text="" wrapText="true" visible="false" maxWidth="Infinity"
                           style="-fx-text-fill: #FCA5A5; -fx-background-color: rgba(220,38,38,0.15); -fx-background-radius: 12; -fx-padding: 16; -fx-font-size: 14px; -fx-font-weight: 600; -fx-border-color: rgba(252,165,165,0.4); -fx-border-width: 1; -fx-border-radius: 12;"/>
                    
                    <Button fx:id="btnLogin" text="SE CONNECTER" onAction="#handleLogin" 
                           maxWidth="Infinity" prefHeight="58"
                           style="-fx-background-color: linear-gradient(to right, #3B82F6, #1D4ED8); -fx-background-radius: 14; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: 700; -fx-cursor: hand;">
                        <effect><DropShadow color="rgba(29,78,216,0.6)" radius="18" offsetY="6"/></effect>
                        <VBox.margin><Insets top="12"/></VBox.margin>
                    </Button>
                    
                    <HBox alignment="CENTER" spacing="12">
                        <VBox.margin><Insets top="8"/></VBox.margin>
                        <Region style="-fx-background-color: rgba(255,255,255,0.15); -fx-pref-height: 1;" HBox.hgrow="ALWAYS"/>
                        <Label text="OU" style="-fx-text-fill: rgba(255,255,255,0.45); -fx-font-size: 13px; -fx-font-weight: 600;"/>
                        <Region style="-fx-background-color: rgba(255,255,255,0.15); -fx-pref-height: 1;" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    
                    <Button text="CREER UN NOUVEAU COMPTE" onAction="#handleRegister" 
                           maxWidth="Infinity" prefHeight="54"
                           style="-fx-background-color: transparent; -fx-background-radius: 14; -fx-border-color: rgba(255,255,255,0.35); -fx-border-radius: 14; -fx-border-width: 2; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: 600; -fx-cursor: hand;">
                    </Button>
                </VBox>
                
                <VBox alignment="CENTER" spacing="5">
                    <VBox.margin><Insets top="30"/></VBox.margin>
                    <Label text="© 2025 REB7A - Systeme de Gestion POS" style="-fx-text-fill: rgba(255,255,255,0.45); -fx-font-size: 12px;"/>
                    <Label text="Version 1.0.0" style="-fx-text-fill: rgba(255,255,255,0.35); -fx-font-size: 11px;"/>
                </VBox>
            </VBox>
        </VBox>
        
    </HBox>
    
</StackPane>
